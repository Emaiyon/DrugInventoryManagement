# DrugTrack Environment Variables

# Backend
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/drugtrack
# For MongoDB Atlas in production:
# MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/drugtrack?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Frontend
VITE_API_URL=http://localhost:5000/api
# In production on Vercel:
# VITE_API_URL=/api
